[Unit]
Description=Ringwall Deterministic Linux Runtime Guardian with Local AI Triage
Documentation=https://github.com/samyxo-bv/ringwall
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ringwalld -config /etc/ringwall/ringwall.yaml
Restart=always
RestartSec=2s
RuntimeDirectory=ringwall
RuntimeDirectoryMode=0750
LogsDirectory=ringwall
LogsDirectoryMode=0750
Group=ringwall

# Least-privilege systemd hardening while retaining BPF/signal/nftables capabilities.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/log/ringwall /run/ringwall /etc/ringwall
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_KILL CAP_NET_ADMIN CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
